# ==============================================================================
#                  KAGGLE COMPETITIONS — ENVIRONMENT CONFIG EXAMPLE
# ==============================================================================
# Copy this file to `.env` (gitignored) and fill in your competition settings.

# Kaggle API Credentials (from https://www.kaggle.com/settings -> API)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_token
KAGGLE_KEY=your_kaggle_api_key

# Competition & Codebase Dataset Targets
KAGGLE_COMPETITION=your-competition-slug
KAGGLE_DATASET_SLUG=your-competition-code
KAGGLE_DATASET_TITLE=Kaggle Competition Codebase

# Corporate Proxy SSL Certificate Bundle (if applicable)
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
